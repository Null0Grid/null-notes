# Maintainer: NULLGRID <volosteele55 at proton dot me>
# Generated by packaging/aur/make-aur.sh from the release's tarballs.
pkgname=null-notes-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Local-first Markdown notes: linked, searchable, encrypted, synced with Null Drive"
arch=('x86_64' 'aarch64')
url="https://nullgrid.dev"
license=('LicenseRef-NULLGRID')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'openssl' 'cairo' 'pango' 'gdk-pixbuf2'
         'hicolor-icon-theme' 'gcc-libs' 'glibc')
provides=('null-notes')
conflicts=('null-notes')
options=('!strip' '!debug')
source_x86_64=("https://github.com/Null0Grid/null-notes/releases/download/${pkgver}/null-notes-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/Null0Grid/null-notes/releases/download/${pkgver}/null-notes-${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  cd "null-notes-${pkgver}-linux-${CARCH}"
  install -Dm755 null-notes "$pkgdir/usr/bin/null-notes"
  install -Dm644 null-notes.desktop "$pkgdir/usr/share/applications/null-notes.desktop"
  for s in 32 128 256 512; do
    install -Dm644 "icons/${s}x${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/null-notes.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
