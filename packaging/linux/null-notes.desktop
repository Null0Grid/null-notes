[Desktop Entry]
Type=Application
Name=Null Notes
GenericName=Notes
Comment=A local markdown vault for notes, pages and images
Exec=null-notes %u
Icon=null-notes
Terminal=false
Categories=Office;Utility;TextEditor;
Keywords=notes;markdown;vault;nullgrid;
MimeType=x-scheme-handler/nullnotes;
StartupWMClass=null-notes
